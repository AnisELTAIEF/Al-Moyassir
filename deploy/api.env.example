# /etc/hifidh/api.env — droits 600, propriétaire root (lu par systemd).
PORT=8787
HOST=127.0.0.1

# MariaDB (base et utilisateur dédiés, créés par l'étape 3 de CLAUDE.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hifidh
DB_USER=hifidh
DB_PASSWORD=A_GENERER
# Ou via socket Unix (souvent /run/mysqld/mysqld.sock) :
# DB_SOCKET=/run/mysqld/mysqld.sock

# Secret de signature des sessions : openssl rand -base64 48
JWT_SECRET=A_GENERER

# Administrateur créé d'office à sa première connexion
BOOTSTRAP_ADMIN_EMAIL=anis.eltaief@gmail.com

# Adresse publique (liens d'invitation) et origine de l'admin web (CORS)
PUBLIC_URL=https://DOMAINE
CORS_ORIGINS=https://DOMAINE

# Identifiants clients OAuth Google acceptés, séparés par des virgules (Web, Android, iOS)
GOOGLE_CLIENT_IDS=

# Durées
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60
INVITATION_TTL_DAYS=14

# --- E-mails d'invitation (optionnel) -------------------------------------------------------
# Sans SMTP_HOST, rien n'est envoyé : l'admin copie le message (ou l'ouvre dans sa messagerie).
# Avec : l'invité reçoit automatiquement un e-mail détaillé, adapté à son rôle.
# Exemple Microsoft 365 (la boîte d'envoi doit être autorisée à l'« envoi SMTP authentifié »,
# à vérifier selon la politique de votre tenant) :
#SMTP_HOST=smtp.office365.com
#SMTP_PORT=587
#SMTP_USER=noreply@bestconsultingit.com
#SMTP_PASSWORD=
#MAIL_FROM="Almoyassir <noreply@bestconsultingit.com>"
# App Android (APK) : par défaut, le fichier déposé ici est servi à https://DOMAINE/api/download/android
# et ce lien est repris automatiquement dans les e-mails d'invitation.
#APK_FILE=/var/lib/hifidh/download/Almoyassir.apk
# Le dossier de APK_FILE est parcouru : le .apk le plus récemment ajouté est servi automatiquement.
# Pour utiliser un autre lien (ex. Google Drive) à la place, le renseigner ici :
#ANDROID_APK_URL=

# Certificats des élèves : dossier de stockage (hors Git, sauvegardé avec la base — voir docs/PLAN-EXECUTION.md B7).
#CERT_DIR=/var/lib/hifidh/certificates

# Alertes quand l'app est fermée (Web Push). Générer UNE FOIS une paire de clés :
#     cd /opt/hifidh/server && node -e "const w=require('web-push').generateVAPIDKeys();console.log(w)"   (ou : npx web-push generate-vapid-keys)
# puis recopier ici. Sans clés, tout fonctionne : seules les alertes app fermée sont désactivées. Ne jamais committer ces valeurs.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:anis.eltaief@gmail.com

# Alertes de l'app Android quand elle est fermée (Firebase Cloud Messaging, 0.22.0) : fichier JSON du compte de service
# (console Firebase → Paramètres du projet → Comptes de service → « Générer une nouvelle clé privée »).
# Le copier sur le serveur, lisible par le seul service, JAMAIS dans Git (voir docs/MISE-A-JOUR-SERVEUR.md) :
#     sudo install -o root -g hifidh -m 640 /tmp/firebase.json /etc/hifidh/firebase-service-account.json && rm /tmp/firebase.json
# Sans ce fichier, tout fonctionne : seules les alertes Android sont désactivées.
#FCM_SERVICE_ACCOUNT_FILE=/etc/hifidh/firebase-service-account.json

